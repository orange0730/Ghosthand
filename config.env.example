# Ghosthand settings. install.sh copies this file to config.env; edit config.env.
# After changing it: sudo systemctl restart pi-iphone-hid pi-iphone-mirror pi-iphone-web

# iPhone screen size in points, portrait (see the table in README.md).
# iPhone 15 Pro Max / 15 Plus / 14 Pro Max / 16 Plus = 430x932
IPHONE_POINTS=430x932

# Name in the iPhone's Screen Mirroring list
MIRROR_NAME=Pi-Agent
# Name in the iPhone's Bluetooth list
BT_NAME=Pi-Agent HID

# Web console
WEB_PORT=8080
# Leave empty for no password (anyone on your Wi-Fi can then control the phone).
# With a password, the browser asks for it; the user name can be anything.
WEB_PASSWORD=

# AI assistant: any OpenAI-compatible chat API that accepts images.
# Google Gemini: get a key at https://aistudio.google.com/apikey
AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AGENT_MODEL=gemini-flash-latest
AGENT_API_KEY=
